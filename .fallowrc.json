{
  "entry": [
    "apps/image-gen/client/src/main.tsx",
    "deploy/fly-gateway/bin/prune-image-deps.mjs",
    "index.ts",
    "runtime-api.ts",
    "channel-plugin-api.ts",
    "configured-state.ts",
    "setup-entry.ts"
  ],
  "framework": [
    {
      "name": "root-vitest",
      "enablers": ["vitest"],
      "entryPointRole": "test",
      "entryPoints": [
        "*.test.ts",
        "src/**/*.test.ts",
        "scripts/**/*.test.mjs",
        "deploy/fly-gateway/**/*.test.mjs"
      ]
    },
    {
      "name": "image-gen-vitest",
      "enablers": ["vitest"],
      "entryPointRole": "test",
      "entryPoints": [
        "apps/image-gen/client/**/*.test.ts",
        "apps/image-gen/server/**/*.test.ts",
        "apps/image-gen/server/**/*.spec.ts",
        "apps/image-gen/scripts/**/*.test.mjs"
      ]
    }
  ],
  "ignoreDependencies": ["@sentry/node", "@trpc/server"],
  "overrides": [
    {
      "files": ["apps/image-gen/**/*.{ts,tsx}"],
      "rules": {
        "unlisted-dependencies": "off"
      }
    }
  ]
}
