{
  "name": "leaderbot-storage-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck:proxy": "tsc --noEmit -p tsconfig.json",
    "test:proxy": "node --import tsx --test deadline.test.ts",
    "build:proxy": "esbuild index.ts --platform=node --target=node24 --bundle --format=cjs --outfile=dist/index.cjs",
    "start:proxy": "tsx index.ts",
    "start:proxy:dist": "node dist/index.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "express": "^4.22.3",
    "express-rate-limit": "8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "rate-limit-redis": "6.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.1"
}
